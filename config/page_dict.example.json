    "product-pdp__prices": "price block of the product detail page (PDP = the main product)",
    "pdp": "product detail page (the main product)",
    "woocommerce-price-amount": "WooCommerce shop price amount (role depends on where it is)",
    "ng-star-inserted": "Angular framework artifact - no meaning",
    "wpb_wrapper": "WPBakery page-builder layout - no meaning",
    "wpb_text_column": "WPBakery page-builder layout - no meaning",
    "wpb_content_element": "WPBakery page-builder layout - no meaning",
    "≈": "approximately (converted by the site)",
    "InStock": "in stock",
    "OutOfStock": "out of stock",
    "PreOrder": "pre-order",
    "BackOrder": "on back order (delivery later)",
